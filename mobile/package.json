{
  "name": "miner-mobile-app",
  "version": "1.0.0",
  "description": "MINER Crypto Mining Platform - Mobile App",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:development": "eas build --profile development --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "expo start --clear",
    "install:deps": "npm install && cd ios && pod install && cd .."
  },
  "dependencies": {
    "expo": "~50.0.0",
    "expo-camera": "~13.4.0",
    "expo-constants": "~14.4.0",
    "expo-device": "~5.4.0",
    "expo-file-system": "~15.4.0",
    "expo-font": "~11.4.0",
    "expo-keep-awake": "~12.3.0",
    "expo-linear-gradient": "~12.3.0",
    "expo-linking": "~5.0.0",
    "expo-location": "~16.1.0",
    "expo-notifications": "~0.20.0",
    "expo-secure-store": "~12.5.0",
    "expo-splash-screen": "~0.20.0",
    "expo-status-bar": "~1.6.0",
    "expo-web-browser": "~12.5.0",
    "react": "18.2.0",
    "react-native": "0.72.0",
    "react-native-safe-area-context": "4.6.0",
    "react-native-screens": "~3.22.0",
    "react-native-web": "~0.19.0",
    "react-native-webview": "13.2.0",
    "@react-native-async-storage/async-storage": "1.19.0",
    "@react-native-community/netinfo": "9.4.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/stack": "^6.3.17",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-pager-view": "6.2.0",
    "react-native-vision-camera": "^3.0.0",
    "react-native-image-picker": "^5.6.0",
    "react-native-fs": "^2.20.0",
    "react-native-permissions": "^3.9.0",
    "react-native-keychain": "^8.1.2",
    "react-native-biometrics": "^3.0.1",
    "react-native-share": "^9.4.1",
    "react-native-svg": "13.9.0",
    "react-native-reanimated": "~3.3.0",
    "react-native-svg-transformer": "^1.0.0",
    "@expo/vector-icons": "^13.0.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-mmkv": "^2.10.1",
    "react-native-paper": "^5.10.1",
    "@tanstack/react-query": "^4.32.6",
    "axios": "^1.5.0",
    "socket.io-client": "^4.7.2",
    "lottie-react-native": "^6.2.0",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "i18next": "^23.4.6",
    "react-i18next": "^13.2.2",
    "react-native-localize": "^3.0.2",
    "ethers": "^6.7.1",
    "web3": "^4.2.0",
    "@walletconnect/web3-provider": "^1.8.0",
    "expo-sqlite": "~13.2.0",
    "expo-crypto": "~12.4.0",
    "expo-random": "~13.2.0",
    "react-native-svg-charts": "^5.12.0",
    "react-native-fast-image": "^8.6.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.0",
    "@types/react-native": "~0.72.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-expo": "^7.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.0.0",
    "typescript": "^5.1.0",
    "jest": "^29.2.0",
    "@types/jest": "^29.4.0",
    "react-test-renderer": "18.2.0",
    "eas-cli": "^5.0.0",
    "expo-cli": "^6.3.0"
  },
  "keywords": [
    "crypto",
    "mining",
    "blockchain",
    "web3",
    "defi",
    "staking",
    "react-native",
    "expo",
    "mobile",
    "cryptocurrency",
    "ethereum",
    "bitcoin",
    "wallet"
  ],
  "author": {
    "name": "MINER Team",
    "email": "support@miner.app",
    "url": "https://miner.app"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/miner-app.git"
  },
  "homepage": "https://miner.app",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|expo|@expo|react-navigation|react-native-web|@walletconnect|ethers)/)"
    ]
  }
}