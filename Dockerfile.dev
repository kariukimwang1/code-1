FROM node:18-alpine

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache git

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application
COPY . .

# Create .next directory if it doesn't exist
RUN mkdir -p .next

# Expose port
EXPOSE 3000

# Start development server
CMD ["npm", "run", "dev"]